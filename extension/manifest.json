{
  "manifest_version": 3,
  "name": "铁花dsh浏览器助手",
  "version": "0.1.0.14",
  "description": "连接 DeepSeek Harness 原生铁花插件，操作当前浏览器。",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "铁花dsh浏览器助手",
    "default_icon": {
      "16": "icons/tiehua16.png",
      "32": "icons/tiehua32.png"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "downloads",
    "notifications",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/tiehua16.png",
    "32": "icons/tiehua32.png",
    "48": "icons/tiehua48.png",
    "128": "icons/tiehua128.png"
  },
  "version_name": "0.1.0-alpha.14"
}
